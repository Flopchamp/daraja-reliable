{
  "name": "daraja-reliable",
  "version": "0.1.0",
  "description": "Idempotency, replay protection and reconciliation for M-Pesa STK Push, above any Daraja SDK.",
  "license": "MIT",
  "author": "Harrison Onyango Aloo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flopchamp/daraja-reliable.git"
  },
  "homepage": "https://github.com/Flopchamp/daraja-reliable#readme",
  "bugs": "https://github.com/Flopchamp/daraja-reliable/issues",
  "keywords": [
    "mpesa",
    "m-pesa",
    "daraja",
    "stk-push",
    "safaricom",
    "payments",
    "idempotency",
    "reconciliation",
    "webhooks",
    "kenya"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-daraja.d.ts",
      "default": "./dist/testing/fake-daraja.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --pool=forks --poolOptions.forks.singleFork"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.23.0",
    "pg": "^8.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
